# MG400 simulation factory contract
#
# Copy this file to .env when you need to override the defaults.
# Node reads this file before spawning MG400simulation-master/simulate_slider.py.

MG400_SIM_MODE=simulation
MG400_SIM_HOST=127.0.0.1
MG400_SIM_BIND_HOST=0.0.0.0
MG400_SIM_DASHBOARD_PORT=29999
MG400_SIM_FEEDBACK_PORT=30004
MG400_SIM_TIMEOUT_MS=10000

# Optional: pin the Python used by the simulation process.
# MG400_SIM_PYTHON=C:\Users\FX506L\AppData\Local\Programs\Python\Python312\python.exe

# Dobot-compatible protocol notes:
# Dashboard: text commands such as EnableRobot(), RobotMode(), GetPose(), MovJ(...)
# Feedback: 1440-byte binary stream compatible with the Dobot feedback structure.
