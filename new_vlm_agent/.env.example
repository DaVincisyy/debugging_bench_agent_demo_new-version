# ============================================================
# VLM Agent 配置示例（默认给 Intern-S1-Pro / LMDeploy）
# 复制成 .env 后按你的部署地址和 key 修改。
# ============================================================

# OpenAI-compatible endpoint
#   LMDeploy 本地常见地址：http://localhost:23333/v1
#   其他平台：
#     OpenAI      : https://api.openai.com/v1
#     DeepSeek    : https://api.deepseek.com
#     DashScope   : https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BASE_URL=http://localhost:23333/v1

# API key（私有部署常可填任意非空串；有鉴权则填真实 key）
VLM_API_KEY=replace-with-your-key

# 模型名（书生）
VLM_MODEL=intern-s1-pro

# 原生 function-calling
VLM_USE_NATIVE_TOOLS=true

# 常规采样参数
VLM_TEMPERATURE=0.2
VLM_MAX_TOKENS=4096

# 连接稳定性（多模态请求大、网关偶发「Server disconnected without sending a response」时可调大）
# VLM_HTTP_TIMEOUT：单次请求总超时（秒），默认 180
# VLM_HTTP_MAX_RETRIES：OpenAI SDK 在单次调用内的 httpx 重试次数，默认 4
# VLM_CONNECT_RETRIES：仍遇 APIConnectionError / 超时 时，整次 chat 重复尝试次数，默认 3（间隔约 4s、8s）
# VLM_HTTP_TIMEOUT=240
# VLM_HTTP_MAX_RETRIES=6
# VLM_CONNECT_RETRIES=5

# 多模态上下文：默认**不删** inline 图；仅当所有 data-URL 估计超过
# VLM_CONTEXT_IMAGE_MAX_BYTES（默认 40MB）时，从**最早**带图的用户消息开始删（最近 K 条先保护，仍超则只保留最新一轮有图消息）。
# VLM_CONTEXT_IMAGE_MAX_BYTES=0 关闭（长任务易触发网关 ~50MB 限制）。
# VLM_CONTEXT_IMAGE_KEEP_LAST=2
#
# Inline image encode budgets (view_image / tool attachments):
#   VLM_BOARD_IMAGE_MAX_PIXELS=0        — board camera photo: no downscale
#   VLM_AGENT_IMAGE_MAX_PIXELS=2000000  — PDF 栅格 PNG（原理图/位号图）: 2M px + JPEG
#   VLM_AGENT_JPEG_QUALITY=85
#   VLM_DEBUG_IMAGE_MAX_PIXELS=2000000    — debug/ disk PNG writes (downscale budget)
#   VLM_DEBUG_JPEG_QUALITY=85             — debug/ disk JPEG writes (falls back to VLM_AGENT_*)
#   VLM_PDF_RASTER_MAX_PIXELS=12000000    — keep faint locator/PDF line art sharp for CV
#   VLM_CONTEXT_IMAGE_MAX_BYTES=1048576 — 上下文 inline 图总量上限 1MB（从最早删）
#   PLANNER_MAX_PIXELS=2000000          — planner 原理图多页
#   PLANNER_JPEG_QUALITY=85

# 通用 thinking 参数（千问/Qwen 等建议 false，否则每步极慢）
VLM_ENABLE_THINKING=false
VLM_REASONING_EFFORT=

# Intern-S1 family only
VLM_THINKING_MODE=false

# Python deps: pip install -r requirements.txt (includes pymupdf for search_pdf_text)

# ============================================================
# Autonomous loop — Cursor SDK（改代码 / apply_plan）
# 复制到 .env 后填写；勿提交真实 key 到 git
# ============================================================
# 获取：Cursor Dashboard → Integrations → API Keys
# 与 VLM_API_KEY 不同：VLM 给 TP agent（Qwen/DashScope），CURSOR 给 Cursor SDK 改代码
# Cursor Pro 订阅与 API 共用同一 usage 池
CURSOR_API_KEY=

# 可选：Cursor apply 使用的模型（默认 composer-2.5）
# CURSOR_APPLY_MODEL=composer-2.5
